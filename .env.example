# ─────────── Public site ───────────
NEXT_PUBLIC_SITE_URL=https://www.highlandcapitals.com
NEXT_PUBLIC_WHATSAPP=971500000000          # digits only, with country code
NEXT_PUBLIC_PHONE=+971500000000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS=
NEXT_PUBLIC_INDIA_OFFICE=
NEXT_PUBLIC_REGISTRATION=
NEXT_PUBLIC_SOCIAL_LINKS=                   # comma-separated profile URLs (used in structured data)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ─────────── Tracking ───────────
NEXT_PUBLIC_GA_ID=                          # GA4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# ─────────── Admin panel (/admin) ───────────
ADMIN_PASSWORD=                             # the password you log in with
ADMIN_SECRET=                               # 32+ random characters, signs the session cookie

# ─────────── Lead + analytics storage ───────────
# Production: add the Upstash Redis (Vercel Marketplace) integration; these are set for you.
# Without them the site stores data in ./.data (fine locally; NOT durable on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────── Google Analytics inside the admin (optional) ───────────
# Create a service account, enable the "Google Analytics Data API", and add its email as a Viewer on the GA4 property.
GA_PROPERTY_ID=                             # numeric property ID (GA4 Admin > Property details)
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY=                             # paste the key; keep the \n sequences

# ─────────── New-lead notifications (optional) ───────────
LEAD_WEBHOOK_URL=                           # Zapier / Make / CRM / Slack-compatible endpoint
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=                          # comma-separated
LEAD_FROM_EMAIL=
